generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENTE
  PROFESIONAL
  ADMIN
}

enum ServiceRequestStatus {
  DRAFT
  OPEN
  QUOTED
  ASSIGNED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id                   String                  @id @default(uuid())
  email                String                  @unique
  passwordHash         String
  fullName             String
  role                 UserRole
  city                 String?
  zone                 String?
  refreshTokenHash     String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  serviceRequests      ServiceRequest[]        @relation("ClientServiceRequests")
  quotes               Quote[]                 @relation("ProfessionalQuotes")
  clientBookings       Booking[]               @relation("ClientBookings")
  professionalBookings Booking[]               @relation("ProfessionalBookings")
  specialties          ProfessionalSpecialty[]
}

model Category {
  id              String                  @id @default(uuid())
  name            String
  slug            String                  @unique
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  serviceRequests ServiceRequest[]
  professionals   ProfessionalSpecialty[]
}

model ServiceRequest {
  id          String               @id @default(uuid())
  title       String
  description String
  status      ServiceRequestStatus @default(OPEN)
  city        String
  zone        String
  budget      String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  clientId    String
  categoryId  String
  client      User                 @relation("ClientServiceRequests", fields: [clientId], references: [id])
  category    Category             @relation(fields: [categoryId], references: [id])
  quotes      Quote[]
  bookings    Booking[]
}

model Quote {
  id               String         @id @default(uuid())
  amount           String
  status           QuoteStatus    @default(PENDING)
  message          String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  serviceRequestId String
  professionalId   String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  professional     User           @relation("ProfessionalQuotes", fields: [professionalId], references: [id])

  @@unique([serviceRequestId, professionalId])
}

model Booking {
  id               String         @id @default(uuid())
  scheduledAt      DateTime
  status           BookingStatus  @default(PENDING)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  serviceRequestId String
  clientId         String
  professionalId   String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  client           User           @relation("ClientBookings", fields: [clientId], references: [id])
  professional     User           @relation("ProfessionalBookings", fields: [professionalId], references: [id])

  @@index([clientId])
  @@index([professionalId, scheduledAt])
  @@index([serviceRequestId])
}

model ProfessionalSpecialty {
  professionalId String
  categoryId     String
  createdAt      DateTime @default(now())
  professional   User     @relation(fields: [professionalId], references: [id])
  category       Category @relation(fields: [categoryId], references: [id])

  @@id([professionalId, categoryId])
  @@index([categoryId])
}
